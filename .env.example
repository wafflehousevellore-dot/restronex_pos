# =============================================================================
# RESTRO NEX — OFFICIAL ARCHITECTURE ENVIRONMENT CONFIGURATION
# Stack: Next.js + TypeScript | Supabase PostgreSQL + Supavisor | Clerk | Razorpay
# =============================================================================

# 1. Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. Database (Supabase PostgreSQL via Supavisor Connection Pooler)
# Production Supavisor Transaction Pooler (Port 6543)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection for Migrations (Port 5432)
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DATABASE_URL="file:./dev.db"

# 3. Supabase Integration & Storage
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# 4. Authentication (Clerk — Sole Auth Provider with Native Supabase Third-Party Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
JWT_SECRET="secure-random-32-characters-minimum-secret-key!!"

# 5. Payment Gateway (Razorpay Only — Server-Verified & Webhook-Secured)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# 6. Meta WhatsApp Business Platform (Tech Provider / Embedded Signup + Cloud API)
# Required for live one-click OTP Meta Embedded Signup & automatic PDF invoice delivery
NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="restronex_whatsapp_verify_token_2026"
META_INVOICE_UTILITY_TEMPLATE="order_invoice_utility"
META_GRAPH_API_VERSION="v21.0"
# Server-side AES-256-GCM encryption & signed private PDF URL secrets
PAYMENT_ENCRYPTION_KEY=""
INVOICE_SIGNING_SECRET=""
CRON_SECRET=""
