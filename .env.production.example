# RestroNex POS SaaS — Production Environment Template
# Copy this file to .env.production or paste into your hosting environment (Vercel, Railway, etc.)

# 1. Base URL & Domain
NEXT_PUBLIC_APP_URL="https://restronex.app"

# 2. Production Database (PostgreSQL URL e.g. Neon, Supabase, AWS RDS)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@ep-sample-pool.us-east-2.aws.neon.tech/restronex?sslmode=require"

# 3. Security & JWT Secret (Must be 32+ random characters)
JWT_SECRET="replace-with-secure-random-32-chars-string-for-prod!!"

# 4. Clerk Authentication (Production instance keys from Clerk Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_YOUR_PRODUCTION_PUBLISHABLE_KEY"
CLERK_PUBLISHABLE_KEY="pk_live_YOUR_PRODUCTION_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="sk_live_YOUR_PRODUCTION_SECRET_KEY"

# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks -> Add Endpoint -> https://your-domain.com/api/webhooks/clerk)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_YOUR_CLERK_WEBHOOK_SECRET"

# 5. Razorpay Payments (Live Keys from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID="rzp_live_YOUR_LIVE_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_LIVE_KEY_SECRET"

# Razorpay Webhook Secret (from Razorpay Dashboard -> Settings -> Webhooks -> https://your-domain.com/api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"
