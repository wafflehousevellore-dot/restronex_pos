generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  clerkId       String?  @unique
  email         String   @unique
  name          String
  avatarUrl     String?
  role          String   @default("OWNER")
  isPlatformAdmin Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  memberships   Membership[]
  auditLogs     AuditLog[]
  platformMfa   PlatformMfaCredential?
}

model PlatformMfaCredential {
  id                  String    @id @default(cuid())
  userId              String    @unique
  enabled             Boolean   @default(false)
  pendingSecretEnc    String?
  pendingCreatedAt    DateTime?
  secretEnc           String?
  backupCodesHashJson String?
  lastUsedStep        Int       @default(-1)
  failedAttempts      Int       @default(0)
  lockedUntil         DateTime?
  enrolledAt          DateTime?
  lastVerifiedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tenant {
  id            String   @id @default(cuid())
  clerkOrgId    String?  @unique
  name          String
  slug          String   @unique
  businessType  String
  email         String
  phone         String
  address       String?
  city          String?
  state         String?
  pincode       String?
  country       String   @default("IN")
  timeZone      String   @default("Asia/Kolkata")
  currency      String   @default("INR")
  status        String   @default("ACTIVE")
  logoUrl       String?
  onboardingStep Int     @default(0)
  onboardingComplete Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  memberships   Membership[]
  outlets       Outlet[]
  settings      RestaurantSetting?
  taxConfigs    TaxConfig[]
  categories    MenuCategory[]
  menuItems     MenuItem[]
  tables        Table[]
  orders        Order[]
  customers     Customer[]
  suppliers     Supplier[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  subscriptions Subscription[]
  integrationConfigs IntegrationConfig[]
  auditLogs     AuditLog[]
  tokens Token[]
  reservations Reservation[]
  feedbacks Feedback[]
  expenses Expense[]
  supplierPrices SupplierPrice[]
  dayEnds DayEndSummary[]
  printerDevices PrinterDevice[]
  printJobs     PrintJob[]
  customerConsents CustomerConsent[]
  whatsAppLogs  WhatsAppDeliveryLog[]
  whatsAppQueue WhatsAppMessageQueue[]
  outletWhatsAppConfigs OutletWhatsAppConfig[]
  invoices      InvoiceRecord[]
  featureUsages FeatureUsage[]
  qrSessions    QrOrderingSession[]
  paymentGatewayConfig TenantPaymentGatewayConfig?
  paymentAttempts PaymentAttempt[]
  paymentRefunds PaymentRefund[]
  subscriptionNotifications SubscriptionNotification[]
  staffInvitations StaffInvitation[]
}

model Membership {
  id              String         @id @default(cuid())
  userId          String
  tenantId        String
  role            String         @default("OUTLET_MANAGER")
  outletId        String?
  status          String         @default("ACTIVE")
  permissionsJson String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet          Outlet?        @relation(fields: [outletId], references: [id])
  staffProfile    StaffProfile?
  outletMembers   OutletMember[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Outlet {
  id          String @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  address     String
  city        String
  phone       String
  status      String @default("ACTIVE")
  serviceModes String @default("DINE_IN,TAKEAWAY,DELIVERY")
  openingHours String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  outletMembers OutletMember[]
  staffInvitations StaffInvitation[]
  tables      Table[]
  orders      Order[]
  stockMovements StockMovement[]
  shifts      CashierShift[]
  tokens Token[]
  reservations Reservation[]
  expenses Expense[]
  dayEnds DayEndSummary[]
  printers    PrinterDevice[]
  printJobs   PrintJob[]
  qrSessions  QrOrderingSession[]
  whatsAppConfig OutletWhatsAppConfig?
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model StaffProfile {
  id           String     @id @default(cuid())
  membershipId String     @unique
  fullName     String
  phone        String?
  employeeCode String?
  jobTitle     String?
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
}

model OutletMember {
  id           String     @id @default(cuid())
  membershipId String
  outletId     String
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  outlet       Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([membershipId, outletId])
  @@index([membershipId])
  @@index([outletId])
}

model StaffInvitation {
  id              String    @id @default(cuid())
  tenantId        String
  email           String
  fullName        String?
  phone           String?
  role            String
  outletId        String?
  outletIdsJson   String?
  permissionsJson String?
  tokenHash       String    @unique
  invitedBy       String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet          Outlet?   @relation(fields: [outletId], references: [id])

  @@index([tenantId])
  @@index([email])
  @@index([tokenHash])
}

model RestaurantSetting {
  id                String @id @default(cuid())
  tenantId          String @unique
  logoUrl           String?
  receiptHeader     String?
  receiptFooter     String?
  gstNumber         String?
  fssaiNumber       String?
  serviceChargePct  Int    @default(0)
  enableKOT         Boolean @default(true)
  enableTableMgmt   Boolean @default(true)
  autoAcceptQROrders       Boolean @default(true)
  autoPrintKOT             Boolean @default(true)
  autoPrintBill            Boolean @default(true)
  autoSendWhatsAppInvoice  Boolean @default(false)
  whatsappSendPdfTaxInvoice Boolean @default(true)
  whatsappSendPaymentConfirm Boolean @default(true)
  whatsappSendOrderConfirm  Boolean @default(false)
  defaultWhatsAppOutletId  String?
  whatsappPhoneNumberId    String?
  whatsappAccessToken      String?
  whatsappWabaId           String?
  whatsappDisplayPhone     String?
  whatsappTemplateName     String? @default("order_invoice_utility")
  whatsappConnectionMode   String? @default("EMBEDDED_SIGNUP")
  whatsappConnectionStatus String @default("NOT_CONFIGURED")
  whatsappCoexistence      Boolean @default(false)
  whatsappConnectedAt      DateTime?
  whatsappLastVerifiedAt   DateTime?
  whatsappVerificationError String?
  whatsappOnboardingSkipped Boolean @default(false)
  printerOnboardingSkipped Boolean @default(false)
  qrFooterEnabled          Boolean @default(true)
  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model OutletWhatsAppConfig {
  id                String    @id @default(cuid())
  tenantId          String
  outletId          String    @unique
  enabled           Boolean   @default(true)
  isDefaultSender   Boolean   @default(false)
  phoneNumberId     String?
  wabaId            String?
  displayPhone      String?
  accessTokenEnc    String?
  templateName      String?   @default("order_invoice_utility")
  connectionMode    String?   @default("EMBEDDED_SIGNUP")
  isCoexistence     Boolean   @default(false)
  status            String    @default("NOT_CONFIGURED")
  verificationError String?
  connectedAt       DateTime?
  lastVerifiedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  outlet            Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}

model TaxConfig {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  rateBps   Int
  isActive  Boolean @default(true)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}

model MenuCategory {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  parentId  String?
  sortOrder Int @default(0)
  isActive  Boolean @default(true)
  imageUrl  String?
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    MenuCategory? @relation("CatParent", fields: [parentId], references: [id])
  children  MenuCategory[] @relation("CatParent")
  items     MenuItem[]
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model MenuItem {
  id          String @id @default(cuid())
  tenantId    String
  categoryId  String
  name        String
  description String?
  imageUrl    String?
  pricePaise  Int
  isVeg       Boolean @default(true)
  isActive    Boolean @default(true)
  isSoldOut   Boolean @default(false)
  taxConfigId String?
  sku         String?
  prepTimeMin Int @default(10)
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  variants    MenuVariant[]
  modifiers   MenuModifier[]
  orderItems  OrderItem[]
  recipe      Recipe?
  @@index([tenantId])
  @@index([categoryId])
  @@index([tenantId, isActive])
  @@index([categoryId, isActive])
}

model MenuVariant {
  id        String @id @default(cuid())
  itemId    String
  name      String
  pricePaise Int
  isActive  Boolean @default(true)
  item      MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model MenuModifier {
  id        String @id @default(cuid())
  itemId    String
  name      String
  pricePaise Int @default(0)
  isActive  Boolean @default(true)
  item      MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Table {
  id        String @id @default(cuid())
  tenantId  String
  outletId  String
  number    String
  area      String @default("Main Hall")
  capacity  Int    @default(4)
  status    String @default("AVAILABLE")
  currentOrderId String?
  qrToken   String?
  qrOrderingEnabled Boolean @default(true)
  waiterName String?
  orderTotalPaise Int @default(0)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet    Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orders    Order[]
  qrSessions QrOrderingSession[]
  @@unique([outletId, number])
  @@index([tenantId])
  @@index([qrToken])
  @@index([tenantId, outletId])
  @@index([outletId, status])
}

model Order {
  id          String @id @default(cuid())
  tenantId    String
  outletId    String
  orderNumber String
  type        String
  status      String @default("OPEN")
  serviceMode String @default("DINE_IN")
  tableId     String?
  customerId  String?
  customerName String?
  customerPhone String?
  subtotalPaise Int @default(0)
  taxPaise    Int @default(0)
  discountPaise Int @default(0)
  serviceChargePaise Int @default(0)
  totalPaise  Int @default(0)
  notes       String?
  kotStatus   String @default("PENDING")
  createdById String?
  isPaid      Boolean @default(false)
  paidAt      DateTime?
  billClosedAt DateTime?
  whatsappConsent Boolean @default(false)
  whatsappStatus String?
  printStatus    String?
  qrSessionId String?
  idempotencyKey String?
  aggregatorOrderId String?
  aggregatorStatus  String?
  channel           String?
  cancelReason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet      Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table       Table? @relation(fields: [tableId], references: [id])
  qrSession   QrOrderingSession? @relation(fields: [qrSessionId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  paymentAttempts PaymentAttempt[]
  kotTickets  KitchenTicket[]
  invoice     InvoiceRecord?
  printJobs   PrintJob[]
  whatsAppLogs WhatsAppDeliveryLog[]
  whatsAppQueue WhatsAppMessageQueue[]
  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, outletId])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([outletId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tableId])
  @@index([tenantId, aggregatorOrderId])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  menuItemId  String
  name        String
  quantity    Int
  unitPricePaise Int
  modifiersJson String?
  variantName String?
  notes       String?
  kotStatus   String @default("PENDING")
  totalPaise  Int
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  @@index([orderId])
  @@index([orderId, menuItemId])
}

model KitchenTicket {
  id             String    @id @default(cuid())
  orderId        String
  tenantId       String
  outletId       String
  station        String    @default("MAIN")
  status         String    @default("RECEIVED")
  priority       Int       @default(0)
  acknowledgedAt DateTime?
  acknowledgedBy String?
  reprintCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([outletId, status])
  @@index([tenantId, outletId, status])
}

model Payment {
  id                 String   @id @default(cuid())
  orderId            String
  tenantId           String?
  outletId           String?
  method             String   // CASH | CARD | UPI | RAZORPAY_ONLINE | EXTERNAL_CARD
  amountPaise        Int
  status             String   @default("COMPLETED") // COMPLETED | FAILED | REFUNDED | PARTIALLY_REFUNDED
  reference          String?
  isGatewayConfirmed Boolean  @default(false)
  razorpayPaymentId  String?
  cardLast4          String?
  cardNetwork        String?
  upiVpa             String?
  refundedPaise      Int      @default(0)
  createdAt          DateTime @default(now())
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds            PaymentRefund[]
  @@index([orderId])
  @@index([tenantId, createdAt])
  @@index([razorpayPaymentId])
}

model PaymentRefund {
  id               String   @id @default(cuid())
  tenantId         String
  paymentId        String
  orderId          String
  amountPaise      Int
  reason           String?
  status           String   @default("PENDING") // PENDING | PROCESSED | FAILED
  razorpayRefundId String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([paymentId])
  @@index([orderId])
}

model CashierShift {
  id          String @id @default(cuid())
  tenantId    String
  outletId    String
  openedById  String
  openingPaise Int @default(0)
  closingPaise Int?
  status      String @default("OPEN")
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  outlet      Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  @@index([outletId, status])
}

model InventoryItem {
  id          String @id @default(cuid())
  tenantId    String
  name        String
  unit        String
  currentStock Float @default(0)
  lowStockThreshold Float @default(5)
  costPerUnitPaise Int @default(0)
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
  supplierPrices SupplierPrice[]
  @@index([tenantId])
}

model Recipe {
  id          String @id @default(cuid())
  menuItemId  String @unique
  yieldQty    Int @default(1)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id              String @id @default(cuid())
  recipeId        String
  inventoryItemId String
  quantity        Float
  recipe          Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  @@unique([recipeId, inventoryItemId])
}

model Supplier {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  address   String?
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  supplierPrices SupplierPrice[]
  @@index([tenantId])
}

model PurchaseOrder {
  id          String @id @default(cuid())
  tenantId    String
  supplierId  String
  poNumber    String
  status      String @default("DRAFT")
  totalPaise  Int @default(0)
  createdAt   DateTime @default(now())
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  @@unique([tenantId, poNumber])
}

model StockMovement {
  id              String @id @default(cuid())
  tenantId        String
  outletId        String?
  inventoryItemId String
  type            String
  quantity        Float
  reference       String?
  createdAt       DateTime @default(now())
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet          Outlet? @relation(fields: [outletId], references: [id])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([outletId, createdAt])
}

model Customer {
  id          String @id @default(cuid())
  tenantId    String
  name        String
  phone       String
  email       String?
  loyaltyPoints Int @default(0)
  totalSpentPaise Int @default(0)
  visitCount  Int @default(0)
  createdAt   DateTime @default(now())
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loyaltyTxns LoyaltyTxn[]
  consents    CustomerConsent[]
  @@unique([tenantId, phone])
  @@index([tenantId])
}

model LoyaltyTxn {
  id          String @id @default(cuid())
  customerId  String
  points      Int
  type        String
  reference   String?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id            String @id @default(cuid())
  name          String @unique
  slug          String @unique
  priceMonthlyPaise Int
  priceAnnualPaise Int
  maxOutlets    Int
  maxUsers      Int
  featuresJson  String
  isActive      Boolean @default(true)
  sortOrder     Int @default(0)
  subscriptions Subscription[]
}

model Subscription {
  id                      String   @id @default(cuid())
  tenantId                String
  planId                  String
  status                  String   @default("PENDING") // PENDING | ACTIVE | PAST_DUE | HALTED | CANCELLED | EXPIRED
  billingCycle            String   @default("MONTHLY") // MONTHLY | ANNUAL
  currentPeriodStart      DateTime @default(now())
  currentPeriodEnd        DateTime
  trialEndsAt             DateTime?
  gracePeriodEndsAt       DateTime?
  cancelledAt             DateTime?
  cancelAtPeriodEnd       Boolean  @default(false)
  razorpaySubscriptionId  String?
  razorpayCustomerId      String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                    SubscriptionPlan @relation(fields: [planId], references: [id])
  payments                SubscriptionPayment[]
  notifications           SubscriptionNotification[]
  @@index([tenantId, status])
  @@index([razorpaySubscriptionId])
}

model SubscriptionNotification {
  id              String   @id @default(cuid())
  subscriptionId  String
  tenantId        String
  daysBefore      Int      // 7, 3, 1, 0
  channel         String   @default("IN_APP") // IN_APP | EMAIL
  title           String
  message         String
  status          String   @default("SENT") // SENT | PENDING | FAILED
  sentAt          DateTime @default(now())
  metadataJson    String?
  createdAt       DateTime @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, daysBefore, channel])
  @@index([tenantId])
}

model SubscriptionPayment {
  id                String   @id @default(cuid())
  subscriptionId    String
  tenantId          String?
  amountPaise       Int
  status            String   @default("PENDING") // PENDING | COMPLETED | FAILED | REFUNDED
  provider          String   @default("RAZORPAY")
  providerPaymentId String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  invoiceNumber     String?
  receiptUrl        String?
  failureReason     String?
  createdAt         DateTime @default(now())
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@index([subscriptionId])
  @@index([providerPaymentId])
  @@index([razorpayPaymentId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("RAZORPAY")
  eventId     String    @unique
  eventType   String?
  tenantId    String?
  payloadJson String
  processed   Boolean   @default(false)
  status      String    @default("PENDING") // PENDING | PROCESSED | FAILED | IGNORED
  error       String?
  attempts    Int       @default(0)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  @@index([tenantId])
  @@index([eventType])
  @@index([status])
}

model TenantPaymentGatewayConfig {
  id                     String   @id @default(cuid())
  tenantId               String   @unique
  provider               String   @default("RAZORPAY")
  isEnabled              Boolean  @default(false)
  keyId                  String?
  keySecretEncrypted     String?
  webhookSecretEncrypted String?
  merchantName           String?
  routeAccountId         String?
  autoCapture            Boolean  @default(true)
  cashEnabled            Boolean  @default(true)
  cardTerminalEnabled    Boolean  @default(true)
  upiManualEnabled       Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PaymentAttempt {
  id                String    @id @default(cuid())
  tenantId          String
  outletId          String
  orderId           String
  gatewayType       String    @default("DIRECT_RAZORPAY") // DIRECT_RAZORPAY | PLATFORM_ROUTE | CASH | EXTERNAL_CARD | UPI_MANUAL
  razorpayOrderId   String?
  razorpayPaymentId String?
  amountPaise       Int
  currency          String    @default("INR")
  status            String    @default("INITIATED") // INITIATED | AUTHORIZED | CAPTURED | FAILED | REFUNDED
  errorCode         String?
  errorMessage      String?
  idempotencyKey    String?   @unique
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, orderId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

model PaymentReconciliationLog {
  id           String   @id @default(cuid())
  tenantId     String?
  source       String   // SUBSCRIPTION | ORDER
  referenceId  String
  status       String   // MATCHED | DISCREPANCY | RESOLVED | FAILED
  notes        String?
  metadataJson String?
  reconciledAt DateTime @default(now())
  @@index([tenantId])
  @@index([status])
  @@index([source, referenceId])
}

model IntegrationConfig {
  id          String @id @default(cuid())
  tenantId    String
  provider    String
  status      String @default("NOT_CONNECTED")
  configJson  String?
  lastSyncAt  DateTime?
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, provider])
}


model Token {
  id        String   @id @default(cuid())
  tenantId  String
  outletId  String
  tokenNo   Int
  queuePos  Int
  status    String   @default("WAITING") // WAITING | COMPLETED | CANCELLED
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  @@index([outletId, status])
  @@index([tenantId])
}

model Reservation {
  id        String   @id @default(cuid())
  tenantId  String
  outletId  String
  name      String
  phone     String
  partySize Int
  date      DateTime
  status    String   @default("BOOKED") // BOOKED | SEATED | CANCELLED | COMPLETED
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  @@index([outletId, date])
  @@index([tenantId])
}

model Feedback {
  id        String   @id @default(cuid())
  tenantId  String
  outletId  String?
  orderId   String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  outletId    String
  category    String
  amountPaise Int
  note        String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([outletId])
}

model SupplierPrice {
  id             String @id @default(cuid())
  tenantId       String
  inventoryItemId String
  supplierId     String
  pricePaise     Int
  updatedAt      DateTime @updatedAt
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  @@unique([inventoryItemId, supplierId])
  @@index([tenantId])
}

model DayEndSummary {
  id          String   @id @default(cuid())
  tenantId    String
  outletId    String
  date        String   // YYYY-MM-DD
  salesPaise  Int      @default(0)
  expensePaise Int     @default(0)
  orders      Int      @default(0)
  closedAt    DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  @@unique([outletId, date])
  @@index([tenantId])
}

model AuditLog {
  id        String @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadataJson String?
  createdAt DateTime @default(now())
  tenant    Tenant? @relation(fields: [tenantId], references: [id])
  user      User? @relation(fields: [userId], references: [id])
  @@index([tenantId])
  @@index([createdAt])
}

model DemoRequest {
  id        String @id @default(cuid())
  name      String
  email     String
  phone     String
  restaurantName String
  city      String
  message   String?
  status    String @default("NEW")
  createdAt DateTime @default(now())
}

model PendingRegistration {
  id             String   @id @default(cuid())
  businessName   String
  ownerName      String
  email          String
  phone          String
  restaurantType String   @default("Restaurant")
  planSlug       String   @default("starter")
  billingCycle   String   @default("MONTHLY")
  status         String   @default("PENDING") // PENDING, PAID, ACTIVATED, EXPIRED
  paymentId      String?
  clerkUserId    String?
  tenantId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model QrOrderingSession {
  id           String   @id @default(cuid())
  tenantId     String
  outletId     String
  tableId      String
  sessionToken String   @unique
  status       String   @default("ACTIVE") // ACTIVE, CLOSED
  guestName    String?
  guestPhone   String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  table        Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  outlet       Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders       Order[]
  @@index([tenantId, outletId])
}

model PrinterDevice {
  id               String   @id @default(cuid())
  tenantId         String
  outletId         String
  name             String
  type             String   // USB_THERMAL, NETWORK_LAN, BLUETOOTH_THERMAL, LOCAL_BRIDGE, OS_PRINT_SERVICE
  paperWidth       String   @default("80mm") // 58mm, 80mm
  connectionString String?  // MAC address, IP:Port, USB device path, or Bluetooth UUID
  bridgeUrl        String?  // Local print bridge / agent HTTP URL if configured
  status           String   @default("DISCONNECTED") // CONNECTED, DISCONNECTED, OFFLINE, ERROR
  isDefaultBilling Boolean  @default(false)
  isDefaultKOT     Boolean  @default(false)
  autoPrintEnabled Boolean  @default(true)
  qrEnabled        Boolean  @default(true)
  compatibilityNote String?
  station          String?  // MAIN, BEVERAGE, KITCHEN, BAR, DESSERT, BILLING
  lastActiveAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  outlet           Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printJobs        PrintJob[]
  routingRules     PrinterRoutingRule[]
  @@index([tenantId, outletId])
}

model PrinterRoutingRule {
  id              String   @id @default(cuid())
  tenantId        String
  outletId        String
  printerId       String
  station         String   // MAIN, KITCHEN, BAR, BEVERAGE, DESSERT, BILLING
  printKOT        Boolean  @default(true)
  printBill       Boolean  @default(false)
  categoryIdsJson String?  // JSON array of category IDs routed to this printer
  printer         PrinterDevice @relation(fields: [printerId], references: [id], onDelete: Cascade)
  @@index([outletId])
}

model PrintJob {
  id             String    @id @default(cuid())
  tenantId       String
  outletId       String
  printerId      String?
  orderId        String?
  idempotencyKey String?
  jobType        String    // KOT, BILL, RECEIPT, TEST, REPORT
  paperWidth     String    @default("80mm")
  contentJson    String    // Formatted receipt / ESC-POS commands / JSON payload
  status         String    @default("QUEUED") // NOT_CONFIGURED, QUEUED, PRINTING, PRINT_REQUESTED, PRINTED, OFFLINE, FAILED
  attempts       Int       @default(0)
  maxRetries     Int       @default(3)
  nextRetryAt    DateTime?
  lastError      String?
  dispatchedAt   DateTime?
  printedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  printer        PrinterDevice? @relation(fields: [printerId], references: [id], onDelete: SetNull)
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  outlet         Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([outletId])
  @@index([status, nextRetryAt])
}

model CustomerConsent {
  id             String   @id @default(cuid())
  tenantId       String
  customerId     String?
  phone          String
  channel        String   @default("WHATSAPP") // WHATSAPP, SMS, EMAIL
  optIn          Boolean  @default(true) // Transactional e-bill delivery consent ONLY
  marketingOptIn Boolean  @default(false) // Explicitly separated promotional marketing opt-in
  optInSource    String   @default("POS_BILLING") // POS_BILLING, QR_ORDER, WEBSITE, WHATSAPP_STOP
  recordedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  @@unique([tenantId, phone, channel])
  @@index([tenantId])
}

model WhatsAppDeliveryLog {
  id             String   @id @default(cuid())
  tenantId       String
  outletId       String?
  orderId        String?
  recipientPhone String
  templateName   String
  messageId      String?  // Meta message ID (wamid.xxx)
  status         String   @default("QUEUED") // QUEUED, SENDING, SENT, DELIVERED, READ, FAILED, OPTED_OUT
  errorMessage   String?
  invoiceUrl     String?
  metadataJson   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  @@index([tenantId, status])
  @@index([recipientPhone])
}

model InvoiceRecord {
  id             String   @id @default(cuid())
  tenantId       String
  outletId       String
  orderId        String   @unique
  invoiceNumber  String
  fileUrl        String?
  pdfStoragePath String?
  subtotalPaise  Int
  taxPaise       Int
  discountPaise  Int
  totalPaise     Int
  customerPhone  String?
  customerName   String?
  status         String   @default("FINALIZED") // DRAFT, FINALIZED, VOIDED
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, outletId])
}

model FeatureUsage {
  id          String   @id @default(cuid())
  tenantId    String
  featureKey  String   // WHATSAPP_INVOICES, QR_ORDERS, KDS_STATIONS, ACTIVE_OUTLETS, PRINTERS
  count       Int      @default(0)
  periodMonth String   // YYYY-MM
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, featureKey, periodMonth])
  @@index([tenantId])
}

model WhatsAppMessageQueue {
  id             String    @id @default(cuid())
  tenantId       String
  outletId       String?
  orderId        String
  invoiceId      String?
  invoiceNumber  String?
  recipientPhone String
  customerName   String?
  messageType    String    @default("INVOICE_BILL") // INVOICE_BILL, ORDER_UPDATE, REFUND
  idempotencyKey String
  status         String    @default("QUEUED") // QUEUED, SENDING, SENT, DELIVERED, READ, FAILED, OPTED_OUT
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  nextRetryAt    DateTime?
  pdfUrl         String?
  messageText    String?
  wamid          String?   // Meta WhatsApp Message ID
  lastError      String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([recipientPhone])
  @@index([status, nextRetryAt])
}
